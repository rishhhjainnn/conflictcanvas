# Database Configuration
# SQLite (default, zero configuration needed) or PostgreSQL:
DATABASE_URL=sqlite:///./conflictcanvas.db
# DATABASE_URL=postgresql://user:password@localhost:5432/conflictcanvas

# JWT Secret Key (CHANGE THIS IN PRODUCTION)
SECRET_KEY=change-this-to-a-secure-random-secret-key

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Demo Mode
DEMO_MODE=true
